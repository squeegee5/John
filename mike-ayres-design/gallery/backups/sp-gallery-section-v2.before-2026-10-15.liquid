<style>
  /* Use Nunito font (matching Boost theme) */
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700&display=swap');
  .sp-gallery-wrapper,
  .sp-gallery-wrapper * {
    font-family: 'Nunito', sans-serif !important;
  }

  /* UNDO Southpaw-specific header fixes — Boost theme header is not fixed */
  .sp-gallery-active .shopify-section--header,
  .sp-gallery-active header.header,
  .sp-gallery-active .header__wrapper {
    position: relative !important;
  }
  /* Restore Boost header — undo any hiding/collapsing */
  .sp-gallery-active header,
  .sp-gallery-active .header-content,
  .sp-gallery-active #shopify-section-header,
  .sp-gallery-active [class*="header-section"] {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    height: auto !important;
    overflow: visible !important;
  }

  /* Remove the 140px padding meant for Southpaw's fixed header */
  .sp-gallery-wrapper {
    padding-top: 10px !important;
  }

  /* Hide breadcrumb */
  .sp-gallery-active .breadcrumbs,
  .sp-gallery-active .breadcrumb,
  .sp-gallery-active .breadcrumb-wrapper,
  .sp-gallery-active .breadcrumbs-container,
  .sp-gallery-active nav.breadcrumb,
  .sp-gallery-active .boost-pfs-filter-breadcrumb,
  .sp-gallery-active [class*="breadcrumb"] {
    display: none !important;
  }

  /* Remove theme page spacing */
  .sp-gallery-active #MainContent,
  .sp-gallery-active main,
  .sp-gallery-active .main-content,
  .sp-gallery-active .page-content,
  .sp-gallery-active [role="main"] {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }
  .sp-gallery-active .shopify-section:first-of-type {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  /* Hide page title — but NOT .page-header which Boost uses for the logo */
  .sp-gallery-active .section-header,
  .sp-gallery-active .page-title-wrapper {
    display: none !important;
  }

  /* Fix sticky filter bar position — sits below Boost's 53px fixed nav */
  .sp-filter-bar {
    top: 53px !important;
  }

  /* Reduce animation jerkiness when switching categories */
  .sp-fade-in {
    transition: opacity 0.4s ease, transform 0.3s ease !important;
  }

  /* === V2 FILTER BAR - MATCHING MOCKUP === */

  /* Override filter bar for row layout */
  .sp-filter-bar {
    flex-wrap: nowrap !important;
    gap: 18px !important;
    padding: 16px 20px !important;
    align-items: center !important;
    flex-direction: row !important;
    justify-content: center !important;
  }

  /* Row alignment: Design Book and Enquire Today align with the gallery buttons (bottom of the group) */
  .sp-filter-bar-row {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    justify-content: center;
    width: 100%;
  }

  /* Offset outside buttons upward by the group's bottom padding (16px) so they line up exactly with the gallery buttons, not the bottom of the enclosure */
  .sp-filter-bar-row > .sp-filter-btn,
  .sp-filter-bar-row > .sp-enquire-btn {
    margin-bottom: 16px;
  }

  /* Enclosure for the gallery category buttons — transparent, shows grouping */
  .sp-filter-group {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 14px 22px 16px;
    border-radius: 22px;
    background: rgba(255,255,255,0.25);
    border: 1.5px solid rgba(160,160,200,0.22);
    box-shadow: 0 2px 16px rgba(100,100,160,0.08), inset 0 1px 2px rgba(255,255,255,0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .sp-filter-group-buttons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Title INSIDE the enclosure, above the buttons */
  .sp-filter-title {
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #4a4a6a;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    width: 100%;
  }
  .sp-filter-title::before,
  .sp-filter-title::after {
    content: '';
    height: 2px;
    width: 110px;
    border-radius: 2px;
  }
  /* Left line: rainbow fading left-to-right */
  .sp-filter-title::before {
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(255,100,100,0.3) 20%,
      rgba(255,180,80,0.45) 40%,
      rgba(120,200,120,0.55) 60%,
      rgba(100,160,220,0.65) 80%,
      rgba(160,120,220,0.75) 100%);
  }
  /* Right line: rainbow fading right-to-left */
  .sp-filter-title::after {
    background: linear-gradient(90deg,
      rgba(160,120,220,0.75) 0%,
      rgba(100,160,220,0.65) 20%,
      rgba(120,200,120,0.55) 40%,
      rgba(255,180,80,0.45) 60%,
      rgba(255,100,100,0.3) 80%,
      transparent 100%);
  }

  /* Button icon — bigger */
  .sp-btn-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
    flex-shrink: 0;
  }

  /* BIGGER buttons */
  .sp-filter-bar .sp-filter-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    white-space: nowrap !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    padding: 11px 20px !important;
    letter-spacing: 0.5px !important;
    border: 2px solid !important;
    background: rgba(255,255,255,0.85) !important;
    transition: all 0.25s ease !important;
  }

  /* Pressed-in look for active/selected buttons (inner shadow, no black) */
  .sp-filter-bar .sp-filter-btn.sp-active {
    background: rgba(240,240,250,0.7) !important;
    color: inherit !important;
    box-shadow:
      inset 0 2px 5px rgba(0,0,0,0.18),
      inset 0 -1px 2px rgba(255,255,255,0.5) !important;
    transform: translateY(1px);
  }

  /* === INDIVIDUAL BUTTON COLORS === */

  /* Design Book — brighter RED border */
  .sp-filter-btn[data-category="designs"] {
    color: #e53030 !important;
    border-color: #ff3838 !important;
  }
  .sp-filter-btn[data-category="designs"]:hover {
    background: rgba(255,56,56,0.08) !important;
    border-color: #ff1f1f !important;
  }
  .sp-filter-btn[data-category="designs"].sp-active {
    background: rgba(255,56,56,0.12) !important;
    color: #d01a1a !important;
  }

  /* All Sensory — white inside, purple border, visible light-purple inner shadow when pressed */
  .sp-filter-btn[data-category="all"] {
    color: #8e5aa8 !important;
    border-color: #b574d0 !important;
    background: #ffffff !important;
  }
  .sp-filter-btn[data-category="all"]:hover {
    background: #ffffff !important;
    border-color: #9a5bbf !important;
  }
  .sp-filter-bar .sp-filter-btn[data-category="all"].sp-active {
    background: #ffffff !important;
    color: #8e5aa8 !important;
    box-shadow:
      inset 0 4px 10px rgba(165,110,200,0.55),
      inset 0 2px 4px rgba(142,90,168,0.35),
      inset 0 -2px 3px rgba(255,255,255,0.6) !important;
  }

  /* MSE — BLUE border. When pressed: dark night-sky background with shimmering stars, white text, inverted icon */
  .sp-filter-btn[data-category="mse"] {
    color: #3d7dc9 !important;
    border-color: #4a90e2 !important;
  }
  .sp-filter-btn[data-category="mse"]:hover {
    background: rgba(74,144,226,0.08) !important;
  }
  .sp-filter-bar .sp-filter-btn[data-category="mse"].sp-active {
    background: linear-gradient(135deg, #0a1a3a 0%, #16325e 45%, #0e2248 100%) !important;
    color: #ffffff !important;
    border-color: #3e6fb8 !important;
    position: relative !important;
    overflow: hidden !important;
    box-shadow:
      inset 0 2px 6px rgba(0,0,0,0.45),
      inset 0 -1px 2px rgba(120,180,255,0.15) !important;
  }
  /* Star field shimmer layer */
  .sp-filter-bar .sp-filter-btn[data-category="mse"].sp-active::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background-image:
      radial-gradient(1px 1px at 8% 30%, #ffffff 99%, transparent),
      radial-gradient(1px 1px at 22% 68%, #e8f0ff 99%, transparent),
      radial-gradient(1.5px 1.5px at 38% 22%, #ffffff 99%, transparent),
      radial-gradient(1px 1px at 52% 80%, #cfe0ff 99%, transparent),
      radial-gradient(1px 1px at 65% 35%, #ffffff 99%, transparent),
      radial-gradient(1.2px 1.2px at 78% 62%, #ffffff 99%, transparent),
      radial-gradient(1px 1px at 88% 28%, #dbe8ff 99%, transparent),
      radial-gradient(1px 1px at 95% 72%, #ffffff 99%, transparent),
      radial-gradient(1.5px 1.5px at 45% 50%, #ffffff 99%, transparent);
    animation: sp-mse-shimmer 2.4s ease-in-out infinite;
    z-index: 0;
  }
  /* Second star layer twinkles out of phase for a more natural sparkle */
  .sp-filter-bar .sp-filter-btn[data-category="mse"].sp-active::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background-image:
      radial-gradient(1px 1px at 15% 50%, #ffffff 99%, transparent),
      radial-gradient(1px 1px at 33% 42%, #b8d0ff 99%, transparent),
      radial-gradient(1px 1px at 58% 18%, #ffffff 99%, transparent),
      radial-gradient(1.2px 1.2px at 72% 78%, #ffffff 99%, transparent),
      radial-gradient(1px 1px at 85% 50%, #cfe0ff 99%, transparent);
    animation: sp-mse-shimmer 3.6s ease-in-out infinite 1.2s;
    z-index: 0;
  }
  /* Keep icon and text above the star layers */
  .sp-filter-bar .sp-filter-btn[data-category="mse"].sp-active > * {
    position: relative;
    z-index: 1;
  }
  /* Swap icon to the inverted (white-on-dark) variant when pressed */
  .sp-filter-bar .sp-filter-btn[data-category="mse"].sp-active .sp-btn-icon {
    content: url('https://cdn.shopify.com/s/files/1/0589/4825/5913/files/inverted_mse.png?v=1776382245') !important;
    filter: drop-shadow(0 0 2px rgba(180,210,255,0.5)) !important;
  }
  @keyframes sp-mse-shimmer {
    0%, 100% { opacity: 0.35; }
    50%      { opacity: 1; }
  }

  /* Soft Play — RAINBOW border. White-ish unpressed, darker rainbow tint when pressed */
  .sp-filter-btn[data-category="soft-play"] {
    color: #555 !important;
    border: 2px solid transparent !important;
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(90deg, #ff6b6b, #ffa94d, #ffd93d, #6bcb77, #4d96ff, #b08cff) border-box !important;
  }
  .sp-filter-btn[data-category="soft-play"]:hover {
    background:
      linear-gradient(rgba(255,250,245,1), rgba(255,250,245,1)) padding-box,
      linear-gradient(90deg, #ff6b6b, #ffa94d, #ffd93d, #6bcb77, #4d96ff, #b08cff) border-box !important;
  }
  .sp-filter-bar .sp-filter-btn[data-category="soft-play"].sp-active {
    color: #555 !important;
    background:
      linear-gradient(rgba(245,245,255,0.7), rgba(245,245,255,0.7)) padding-box,
      linear-gradient(90deg, #ff6b6b, #ffa94d, #ffd93d, #6bcb77, #4d96ff, #b08cff) border-box !important;
    box-shadow:
      inset 0 2px 5px rgba(0,0,0,0.18),
      inset 0 -1px 2px rgba(255,255,255,0.5) !important;
  }

  /* Tactile Murals — purple/blue/pink gradient border. White-ish unpressed, darker gradient tint when pressed */
  .sp-filter-btn[data-category="murals"] {
    color: #7a5aa8 !important;
    border: 2px solid transparent !important;
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(90deg, #b57edb, #8a7ee0, #5d9be8, #e668b5, #b85aa8) border-box !important;
  }
  .sp-filter-btn[data-category="murals"]:hover {
    background:
      linear-gradient(rgba(252,248,255,1), rgba(252,248,255,1)) padding-box,
      linear-gradient(90deg, #b57edb, #8a7ee0, #5d9be8, #e668b5, #b85aa8) border-box !important;
  }
  .sp-filter-bar .sp-filter-btn[data-category="murals"].sp-active {
    color: #7a5aa8 !important;
    background:
      linear-gradient(rgba(245,240,250,0.7), rgba(245,240,250,0.7)) padding-box,
      linear-gradient(90deg, #b57edb, #8a7ee0, #5d9be8, #e668b5, #b85aa8) border-box !important;
    box-shadow:
      inset 0 2px 5px rgba(0,0,0,0.18),
      inset 0 -1px 2px rgba(255,255,255,0.5) !important;
  }

  /* Projection — PINK border */
  .sp-filter-btn[data-category="projection"] {
    color: #d94a88 !important;
    border-color: #ec5fa0 !important;
  }
  .sp-filter-btn[data-category="projection"]:hover {
    background: rgba(236,95,160,0.08) !important;
  }
  .sp-filter-btn[data-category="projection"].sp-active {
    background: rgba(236,95,160,0.15) !important;
  }

  /* De-escalation — LIGHT BLUE border */
  .sp-filter-btn[data-category="de-escalation"] {
    color: #4aa3c4 !important;
    border-color: #5dbce0 !important;
  }
  .sp-filter-btn[data-category="de-escalation"]:hover {
    background: rgba(93,188,224,0.08) !important;
  }
  .sp-filter-btn[data-category="de-escalation"].sp-active {
    background: rgba(93,188,224,0.15) !important;
  }

  /* Enquire Today — brighter GREEN bolder border */
  .sp-enquire-btn {
    color: #1fb958 !important;
    border: 2.5px solid #1fd263 !important;
  }
  .sp-enquire-btn:hover {
    background: rgba(31,210,99,0.1) !important;
    border-color: #14bd52 !important;
  }

  /* === Even faster background animations === */
  .sp-light-orb:nth-child(1) { animation-duration: 6s !important; }
  .sp-light-orb:nth-child(2) { animation-duration: 7.5s !important; }
  .sp-light-orb:nth-child(3) { animation-duration: 5.5s !important; }
  .sp-light-orb:nth-child(4) { animation-duration: 7s !important; }
  .sp-light-orb:nth-child(5) { animation-duration: 5s !important; }
  .sp-light-orb:nth-child(6) { animation-duration: 6.5s !important; }
  .sp-light-orb:nth-child(7) { animation-duration: 6s !important; }

  /* Responsive: wrap on smaller screens */
  @media (max-width: 1200px) {
    .sp-filter-bar {
      flex-wrap: wrap !important;
    }
    .sp-filter-group-buttons {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>

